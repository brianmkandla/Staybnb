@model IEnumerable<Staybnb.Models.ActivityLog>

@{
    ViewData["Title"] = "Activity Logs";
}

<div class="container py-4">
    <h1 class="mb-2">Activity Logs</h1>
    <p class="text-muted mb-4">
        Review recent recorded activity across Staybnb.
    </p>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No activity logs have been recorded yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Date and Time</th>
                        <th>User</th>
                        <th>Activity Type</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td>
                                @log.CreatedAt.ToString("dd MMM yyyy HH:mm")
                            </td>
                            <td>
                                @(string.IsNullOrWhiteSpace(log.User?.Email)
                                    ? log.UserId
                                    : log.User.Email)
                            </td>
                            <td>
                                <span class="badge bg-secondary">
                                    @log.ActivityType
                                </span>
                            </td>
                            <td>@log.Action</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
