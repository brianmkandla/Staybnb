
@model IEnumerable<Staybnb.Models.HostProperty>

@{
    ViewData["Title"] = "Explore Properties";
}

<div class="container mt-4">
    <h1>Explore Properties</h1>
    <p class="text-muted">
        Find a place to stay that feels like home.
    </p>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No properties are currently available. Please check again later.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var property in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (property.Images.Any())
                        {
                            <img src="@property.Images.First().ImageUrl"
                                 class="card-img-top"
                                 alt="@property.Title"
                                 style="height: 220px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center
                                        justify-content-center"
                                 style="height: 220px;">
                                <span class="text-muted">
                                    No image available
                                </span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@property.Title</h5>

                            <p class="text-muted mb-2">
                                @property.City
                            </p>

                            <p class="mb-2">
                                @property.PropertyType
                            </p>

                            <p class="mb-3">
                                @(property.Description.Length > 120
                                    ? property.Description.Substring(0, 120) + "..."
                                    : property.Description)
                            </p>

                            <p class="fw-bold mt-auto">
                                R @property.PricePerNight.ToString("N2")
                                <span class="text-muted fw-normal">
                                    / night
                                </span>
                            </p>

                            <a asp-controller="Properties"
                               asp-action="Details"
                               asp-route-id="@property.Id"
                               class="btn btn-primary">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
