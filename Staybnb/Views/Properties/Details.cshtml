
@model Staybnb.Models.HostProperty

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <a asp-controller="Properties"
       asp-action="Index"
       class="btn btn-outline-secondary mb-3">
        &larr; Back to Properties
    </a>

    <div class="row">
        <div class="col-lg-8">
            <h1>@Model.Title</h1>

            <p class="text-muted">
                @Model.Address, @Model.City
            </p>

            @if (Model.Images.Any())
            {
                <div class="row g-3 mb-4">
                    @foreach (var image in Model.Images)
                    {
                        <div class="col-md-6">
                            <img src="@image.ImageUrl"
                                 alt="@Model.Title"
                                 class="img-fluid rounded shadow-sm"
                                 style="width: 100%; height: 240px;
                                        object-fit: cover;" />
                        </div>
                    }
                </div>
            }

            <h4>About this property</h4>
            <p style="white-space: pre-line;">@Model.Description</p>

            <hr />

            <p>
                <strong>Property type:</strong>
                @Model.PropertyType
            </p>

            <p>
                <strong>Hosted by:</strong>
                @Model.Host.FirstName @Model.Host.LastName
            </p>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3>
                        R @Model.PricePerNight.ToString("N2")
                        <small class="text-muted">/ night</small>
                    </h3>

                    <hr />

                    <p>
                        <strong>Cleaning fee:</strong>
                        R @Model.CleaningFee.ToString("N2")
                    </p>

                    <p>
                        <strong>Service fee:</strong>
                        R @Model.ServiceFee.ToString("N2")
                    </p>

                    <p class="text-muted small">
                        The final booking total will depend on your
                        selected dates and length of stay.
                    </p>

                    @if (User.Identity?.IsAuthenticated == true
                        && User.IsInRole("Guest"))
                    {
                        <a asp-controller="Bookings"
                           asp-action="Create"
                           asp-route-propertyId="@Model.Id"
                           class="btn btn-primary w-100">
                            Book This Property
                        </a>
                    }
                    else if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           class="btn btn-primary w-100">
                            Sign in to Book
                        </a>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">
                            Booking as a guest is not available for this account.
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
