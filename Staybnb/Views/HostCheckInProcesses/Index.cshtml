
@model IEnumerable<Staybnb.Models.HostProperty>
@using Staybnb.Models

@{
    ViewData["Title"] = "Check-in Instructions";
    var processes = ViewBag.Processes as IDictionary<int, CheckInProcess>
        ?? new Dictionary<int, CheckInProcess>();
}

<div class="container py-4">
    <h1>Guest Check-in Instructions</h1>
    <p class="text-muted">
        Configure arrival instructions and the documents guests must provide.
    </p>

    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No properties found for your host account.
        </div>
    }

    @foreach (var property in Model)
    {
        var configured = processes.ContainsKey(property.Id);

        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@property.Title</h5>
                <p class="text-muted">@property.City</p>

                @if (configured)
                {
                    <span class="badge bg-success">Instructions configured</span>
                    <p class="mt-2 mb-0">
                        @processes[property.Id].Title
                    </p>
                }
                else
                {
                    <span class="badge bg-warning text-dark">
                        Setup required
                    </span>
                }

                <div class="mt-3">
                    <a asp-action="Edit"
                       asp-route-propertyId="@property.Id"
                       class="btn btn-primary">
                        @(configured ? "Edit Instructions" : "Configure Check-in")
                    </a>
                </div>
            </div>
        </div>
    }
</div>
