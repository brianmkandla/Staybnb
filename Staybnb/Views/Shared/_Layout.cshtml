
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"] - Staybnb</title>

        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/Staybnb.styles.css" asp-append-version="true" />
    </head>
    <body>
        <header>
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-3">
                <div class="container-fluid">
                    <a class="navbar-brand fw-bold"
                    asp-controller="Home"
                    asp-action="Index">
                        Staybnb
                    </a>

                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#mainNavbar"
                            aria-controls="mainNavbar"
                            aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNavbar">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link"
                                asp-controller="Home"
                                asp-action="Index">
                                    Home
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                asp-controller="Properties"
                                asp-action="Index">
                                    Browse Properties
                                </a>
                            </li>

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                @if (User.IsInRole("Guest"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link"
                                        asp-controller="Bookings"
                                        asp-action="MyBookings">
                                            My Bookings
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link"
                                        asp-controller="HostApplication"
                                        asp-action="Create">
                                            Become a Host
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link"
                                        asp-controller="GuestCheckIns"
                                        asp-action="Index">
                                            Guest Check-in
                                        </a>
                                    </li>
                                }

                                @if (User.IsInRole("Host"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link"
                                        asp-controller="HostProperties"
                                        asp-action="Index">
                                            My Properties
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link"
                                        asp-controller="HostBookings"
                                        asp-action="Index">
                                            Manage Bookings
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link"
                                        asp-controller="HostCheckInProcesses"
                                        asp-action="Index">
                                            Check-in Instructions
                                        </a>
                                    </li>

                                    <a class="nav-link"
                                    asp-controller="HostGuestDocuments"
                                    asp-action="Index">
                                        Review Guest Documents
                                    </a>
                                }

                                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link"
                                        asp-controller="AdminHostApplications"
                                        asp-action="Index">
                                            Host Applications
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link"
                                        asp-controller="AdminActivityLogs"
                                        asp-action="Index">
                                            Activity Logs
                                        </a>
                                    </li>
                                }
                            }

                            <li class="nav-item">
                                <a class="nav-link"
                                asp-controller="Home"
                                asp-action="Privacy">
                                    Privacy
                                </a>
                            </li>
                        </ul>

                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </header>

        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="border-top footer text-muted">
            <div class="container py-3">
                &copy; 2026 - Staybnb -
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>
